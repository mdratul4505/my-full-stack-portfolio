# Database Connection (PostgreSQL with Prisma)
# Local PostgreSQL default on port 5433 (or standard port 5432 / Supabase / Neon / Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portfolio_db?schema=public"
# DIRECT_URL is required by cloud connection poolers like Supabase/Neon (optional for local)
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/portfolio_db?schema=public"

# Authentication Secret (Generate a strong 32+ character random string in production, e.g. `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Initial Admin Account Setup (used by `npm run db:admin` to seed initial admin user)
ADMIN_INITIAL_EMAIL="admin@ratulhasan.dev"
ADMIN_INITIAL_PASSWORD="ChangeThisPassword123!"
ADMIN_INITIAL_NAME="Md. Ratul Hasan"

# Contact Form & Email Provider Options:
# Option 1: Gmail SMTP (Direct Google account with 16-character App Password)
GMAIL_USER="dev.ratul.coder@gmail.com"
GMAIL_APP_PASSWORD=""

# Option 2: Resend (Get your free API key at https://resend.com)
RESEND_API_KEY=""

# Email address where contact form notifications will be delivered
CONTACT_RECEIVER_EMAIL="dev.ratul.coder@gmail.com"
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
